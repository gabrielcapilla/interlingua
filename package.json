{
  "name": "interlingua",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "bun test --max-concurrency=1",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run format:check && bun run build",
    "format": "biome format --write src scripts",
    "format:check": "biome check src scripts",
    "lint": "biome lint src scripts",
    "test:coverage": "bun test --max-concurrency=1 --coverage",
    "benchmark:local": "bun run scripts/evaluate-model.ts",
    "measure:chunking": "bun run scripts/measure-chunking.ts",
    "measure:runtime": "bun run scripts/measure-runtime.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.9",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
